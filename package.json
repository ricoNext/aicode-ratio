{
  "name": "aicode-ratio",
  "version": "0.1.0",
  "description": "Track AI coding agents (Cursor, Claude Code, etc.) via editor hooks and Git — AI vs human code ratio reports",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "aicode-ratio": "./dist/cli.js",
    "acr": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricoNext/aicode-ratio.git"
  },
  "bugs": {
    "url": "https://github.com/ricoNext/aicode-ratio/issues"
  },
  "homepage": "https://github.com/ricoNext/aicode-ratio#readme",
  "keywords": [
    "ai",
    "agent",
    "ratio",
    "cursor",
    "claude",
    "git",
    "report"
  ],
  "author": "RicoNext",
  "license": "MIT",
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "commander": "^12.0.0",
    "micromatch": "^4.0.8",
    "zod": "^3.23.0"
  }
}
